# ─────────────────────────────────────────────
# WTK-Games Environment Variables — EXAMPLE
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ environment ของคุณ
# cp .env.example .env
# ─────────────────────────────────────────────

# Server Port
PORT=3001

# Admin Secret Key (ใช้กับ ?admin_key=xxx ใน URL)
# ⚠️ เปลี่ยนเป็นรหัสที่ยากก่อน deploy จริง
ADMIN_SECRET_KEY=change_me_before_deploy

# Colyseus Monitor Dashboard — /colyseus (Basic Auth)
# ⚠️ เปลี่ยนก่อน deploy จริง
MONITOR_USER=admin
MONITOR_PASS=change_me_before_deploy
