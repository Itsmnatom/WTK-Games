{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false
  },
  "include": [
    "colyseus_server.ts",
    "game/**/*.ts",
    "rooms/**/*.ts",
    "db/**/*.ts",
    "plugins/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "public", "tests", "server.js"]
}
